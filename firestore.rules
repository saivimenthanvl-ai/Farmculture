rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents must be keyed strictly by Firebase Authentication UID
    match /users/{userId} {
      // Users can only read and write their own document matching their authenticated UID
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && (request.resource.data.uid == userId || !('uid' in request.resource.data));
      allow update: if request.auth != null 
                    && request.auth.uid == userId
                    && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Crop assessment history strictly owner-restricted
      match /assessments/{assessmentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Support requests submitted through Contact Us portal
    match /support_requests/{requestId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false; // immutable audit log
    }

    // Community ratings and reviews
    match /reviews/{reviewId} {
      // Public can read approved reviews; authors can read their own pending reviews
      allow read: if (resource.data.moderationStatus == 'approved') 
                  || (request.auth != null && resource.data.userId == request.auth.uid);
      // Authenticated users can create reviews where userId matches their authenticated UID
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.reviewText is string
                    && request.resource.data.reviewText.size() >= 5
                    && request.resource.data.reviewText.size() <= 1000
                    && request.resource.data.moderationStatus in ['approved', 'pending'];
      // Authors can update or delete only their own reviews
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
